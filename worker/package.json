{
  "name": "@library-tracker/worker",
  "version": "0.1.0",
  "private": true,
  "description": "BullMQ worker: scraper registry, Puppeteer scrapes, checkout upserts.",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --env-file=.env src/index.js",
    "enqueue-daily": "node src/enqueueDaily.js",
    "enqueue-daily:dev": "node --env-file=.env src/enqueueDaily.js",
    "reseed-demo": "node scripts/reseed-demo.js",
    "seed-test-fixtures": "node scripts/seed-test-fixtures.js",
    "scrape-local": "node scripts/scrape-local.js",
    "admin": "node --env-file=.env.admin admin/server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@googleapis/calendar": "^20.0.0",
    "@library-tracker/db": "file:../db",
    "ajv": "^8.20.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.6",
    "ioredis": "^6.0.0",
    "puppeteer": "^25.11.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "dotenv": "^18.0.0"
  }
}
