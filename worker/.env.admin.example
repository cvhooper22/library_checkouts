# Config for the local scrape admin page (`npm run admin`).
# Copy to .env.admin (gitignored) and fill in. Kept separate from .env so a stray
# dev command can't pick up production settings, and vice versa.

# Render Postgres, EXTERNAL Database URL (the internal one only resolves inside Render).
# Keep ?sslmode=require on the end — Render requires SSL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.render.com/DBNAME?sslmode=require"

# Must be the SAME value the API service uses — the API encrypts library credentials
# with it and this page decrypts them at scrape time. Never commit the real one.
CREDENTIAL_ENCRYPTION_KEY=""

# Disables the test-* fixture scrapers, same as production.
NODE_ENV="production"

# Recorded on each run row so you can tell manual runs from worker runs.
SCRAPER_VERSION="admin-local"

# Optional: change the port (default 4100).
# ADMIN_PORT=4100
