DATABASE_URL="postgresql://user:password@localhost:5432/library_tracker"
REDIS_URL="redis://localhost:6379"
CREDENTIAL_ENCRYPTION_KEY="generate-with: openssl rand -base64 32"
NODE_ENV="development"
WORKER_CONCURRENCY=1
SCRAPER_VERSION="dev"

# Google Calendar reminders: the same OAuth web client as the API's. A finished scrape
# re-syncs its household's calendar, and scripts/sync-calendars.js syncs them all; both
# refresh each household's stored grant with these. Unset is fine until a household
# connects a calendar (the sync records "must be set" on that link until then).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# scripts/scrape-local.js only — exercises one scraper directly, no queue/DB needed
SCRAPER_TYPE=koha
SCRAPER_BASE_URL=https://butte.bywatersolutions.com
SCRAPER_USERNAME=
SCRAPER_PIN=
# set to false to watch the browser instead of running headless
SCRAPER_HEADLESS=true
# set to true to dump scraper-debug.png / scraper-debug.html on failure
SCRAPER_DEBUG=false
