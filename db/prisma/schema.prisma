generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  ownedHouseholds  Household[]        @relation("HouseholdOwner")
  householdMembers HouseholdMember[]
  calendarLinks    CalendarLink[]

  @@map("users")
}

model Household {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  ownerUserId String   @map("owner_user_id") @db.Uuid
  isDemo      Boolean  @default(false) @map("is_demo")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  owner   User              @relation("HouseholdOwner", fields: [ownerUserId], references: [id])
  members HouseholdMember[]
  accounts Account[]
  calendarLink        CalendarLink?
  calendarRevocations CalendarRevocation[]

  @@map("households")
}

model HouseholdMember {
  householdId String @map("household_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid
  role        String

  household Household @relation(fields: [householdId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@id([householdId, userId])
  @@map("household_members")
}

model Library {
  id                  String  @id @default(uuid()) @db.Uuid
  slug                String  @unique
  name                String
  baseUrl             String  @map("base_url")
  scraperTypeDefault  String  @map("scraper_type_default")
  isActive            Boolean @default(true) @map("is_active")
  city                String?
  state               String?
  postalCode          String? @map("postal_code")

  accounts Account[]

  @@map("libraries")
}

model Account {
  id                   String    @id @default(uuid()) @db.Uuid
  householdId          String    @map("household_id") @db.Uuid
  displayName          String    @map("display_name")
  libraryId            String    @map("library_id") @db.Uuid
  scraperType          String    @map("scraper_type")
  scraperConfig        Json      @default("{}") @map("scraper_config")
  credentialsEncrypted String    @map("credentials_encrypted")
  scheduleCron         String    @default("0 6 * * *") @map("schedule_cron")
  lastRunAt            DateTime? @map("last_run_at") @db.Timestamptz
  lastStatus           String?   @map("last_status")
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz

  household Household  @relation(fields: [householdId], references: [id])
  library   Library    @relation(fields: [libraryId], references: [id])
  runs      Run[]
  checkouts Checkout[]

  @@map("accounts")
}

model Run {
  id              String    @id @default(uuid()) @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz
  status          String
  error           String?
  scraperVersion  String    @map("scraper_version")
  rawOutput       Json?     @map("raw_output")

  account   Account    @relation(fields: [accountId], references: [id])
  checkouts Checkout[]

  @@map("runs")
}

model Checkout {
  id           String    @id @default(uuid()) @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  runId        String    @map("run_id") @db.Uuid
  externalId   String    @map("external_id")
  title        String
  dueDate      DateTime  @map("due_date") @db.Date
  overdue      Boolean   @default(false)
  imgSrc       String?   @map("img_src")
  firstSeenAt  DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  returnedAt   DateTime? @map("returned_at") @db.Timestamptz

  account Account @relation(fields: [accountId], references: [id])
  run     Run     @relation(fields: [runId], references: [id])

  @@unique([accountId, externalId])
  @@map("checkouts")
}

// A household's Google Calendar, connected through one member's OAuth grant: the
// sync writes a single due-date reminder event to `calendarId` as that user. Only
// `connectedUserId` may change or disconnect it. The refresh token is encrypted
// like account credentials and only ever decrypted in the worker.
model CalendarLink {
  id                    String    @id @default(uuid()) @db.Uuid
  householdId           String    @unique @map("household_id") @db.Uuid
  connectedUserId       String    @map("connected_user_id") @db.Uuid
  refreshTokenEncrypted String    @map("refresh_token_encrypted")
  calendarId            String    @map("calendar_id")
  reminderTime          Int       @default(480) @map("reminder_time") // minutes after midnight in timeZone
  timeZone              String    @map("time_zone") // IANA, e.g. America/Los_Angeles
  showTitles            Boolean   @default(true) @map("show_titles")
  enabled               Boolean   @default(true)
  lastSyncedAt          DateTime? @map("last_synced_at") @db.Timestamptz
  lastError             String?   @map("last_error")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  household     Household @relation(fields: [householdId], references: [id])
  connectedUser User      @relation(fields: [connectedUserId], references: [id])

  @@map("calendar_links")
}

// A disconnect waiting on the worker. Disconnecting deletes the CalendarLink row at
// once (so the household can reconnect right away) and queues this, because revoking
// needs the decrypted token and only the worker decrypts. The worker deletes the
// event, the calendar too if asked, revokes the grant, then deletes this row.
model CalendarRevocation {
  id                    String   @id @default(uuid()) @db.Uuid
  householdId           String   @map("household_id") @db.Uuid
  refreshTokenEncrypted String   @map("refresh_token_encrypted")
  calendarId            String   @map("calendar_id")
  eventId               String   @map("event_id")
  deleteCalendar        Boolean  @default(false) @map("delete_calendar")
  requestedAt           DateTime @default(now()) @map("requested_at") @db.Timestamptz
  lastError             String?  @map("last_error")

  household Household @relation(fields: [householdId], references: [id])

  @@map("calendar_revocations")
}
