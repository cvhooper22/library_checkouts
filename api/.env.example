DATABASE_URL="postgresql://user:password@localhost:5432/library_tracker"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="generate with: openssl rand -base64 32"
# Must match the worker's CREDENTIAL_ENCRYPTION_KEY exactly — the API encrypts
# credentials on write, the worker decrypts them at scrape time.
CREDENTIAL_ENCRYPTION_KEY="generate with: openssl rand -base64 32"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Number of reverse-proxy hops in front of the API (Render = 1). Needed so the
# IP-keyed rate limiters see the real client IP instead of the proxy's. Leave
# unset locally — with no proxy, trusting X-Forwarded-For lets clients spoof it.
# TRUST_PROXY=1

# OAuth 2.0 Client ID from Google Cloud Console — used as the expected
# audience when verifying Google ID tokens in POST /auth/google, and as the OAuth
# client for connecting a household's Google Calendar.
GOOGLE_CLIENT_ID=""

# Google Calendar reminders (routes/calendar.js), behind CALENDAR_ENABLED below.
# The same web client's secret; sign-in alone never needed it, connecting a calendar
# does. Never commit the real one.
GOOGLE_CLIENT_SECRET=""
# Where Google sends the user back: the frontend's /calendar/callback page. Must match
# an "Authorized redirect URI" on the client exactly.
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:5173/calendar/callback"
# Feature flag for /households/:id/calendar and the Set up page's calendar section.
# Opt-in like REFRESH_ENABLED: on only when exactly "true".
CALENDAR_ENABLED=true

# Feature flag for POST /accounts/:id/refresh and the frontend's Re-stamp button.
# Opt-in: on only when exactly "true"; unset or anything else keeps it off. Turn it
# on locally to exercise the queue -> worker -> frontend path.
REFRESH_ENABLED=true

# Where refreshes run. Unset = BullMQ queue + worker (needs REDIS_URL). "github" = start
# .github/workflows/scrape.yml instead, with no queue or worker; needs the two below.
# SCRAPE_BACKEND=github
# GITHUB_REPO="owner/repo"
# Needs permission to run workflows on that repo (fine-grained: Actions read/write).
# GITHUB_DISPATCH_TOKEN=""
# GITHUB_REF=main

# Kill switch for POST /auth/demo — set to "false" to disable the "Try it out"
# flow without a deploy. See adr/0002-demo-mode.md.
DEMO_MODE_ENABLED=true
