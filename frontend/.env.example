# Copy to .env (gitignored). Baked in at build time — on Render, set it on the static site service.
VITE_API_URL=http://localhost:3000

# OAuth 2.0 Client ID from Google Cloud Console, for the "Continue with Google" button.
# Must match the API's GOOGLE_CLIENT_ID (api/.env.example) — that's the audience it
# checks POST /auth/google id tokens against. In the Google Cloud Console, add this
# app's origin (e.g. http://localhost:5173) under the client's "Authorized JavaScript
# origins". Leave unset to keep the button disabled.
VITE_GOOGLE_CLIENT_ID=
